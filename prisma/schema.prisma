generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


model User {
  id        Int      @id @default(autoincrement())
  name      String
  firstName String? @map("first_name")
  email     String   @unique
  password  String 
  role      Role @default(MECHANIC)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mechanic Mechanic?
  receptionist Receptionist?

  @@map("users")
}

model Customer {
  id Int @id @default(autoincrement())
  name String 
  firstName String? @map("first_name")
  address String?
  email String? @unique
  phoneNumber String @map("phone")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle Vehicle[]

  @@map("customers")
}

model Vehicle {
  id Int @id @default(autoincrement())
  immatriculation String @unique
  model String
  year String
  brand String
  fuel_type Fuel
  transmission Transmission

  idCustomer Int
  customer Customer @relation(fields: [idCustomer], references: [id])


  @@map("vehicles")
} 

model Mechanic {
  id Int @id @default(autoincrement())
  speciality String
  salary String 
  is_available Boolean @default(true)
  phoneNumber String @map("phone")
  hire_date DateTime 

  idUser Int @unique
  user User @relation(fields: [idUser], references: [id])

  @@map("mechanics")
}

model Receptionist {
  id Int @id @default(autoincrement())
  salary String
  hire_date DateTime
  phoneNumber String @map("phone")
  is_active Boolean @default(true)

  idUser Int @unique
  user User @relation(fields: [idUser], references: [id])

  @@map("receptionists")
}

enum Transmission {
  MANUEL
  AUTOMATIC
}

enum Fuel {
  ESSENCE
  DIESEL
}
enum Role {
  MECHANIC
  ADMIN
  RECEPTIONIST
  WORKSHOP_MANAGER
}

