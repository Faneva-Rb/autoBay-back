generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}


model User {
  id        Int      @id @default(autoincrement())
  name      String
  firstName String? @map("first_name")
  email     String   @unique
  password  String 
  role      Role @default(MECHANIC)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mechanic Mechanic?
  receptionist Receptionist?

  @@map("users")
}

model Customer {
  id Int @id @default(autoincrement())
  name String 
  firstName String? @map("first_name")
  address String?
  email String? @unique
  phoneNumber String @map("phone")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointments Appointment[]
  vehicle Vehicle[]

  @@map("customers")
}

model Vehicle {
  id Int @id @default(autoincrement())
  immatriculation String @unique
  model String
  year String
  brand String
  fuel_type Fuel
  transmission Transmission

  idCustomer Int
  customer Customer @relation(fields: [idCustomer], references: [id])

  appointments Appointment[]

  @@map("vehicles")
} 

model Mechanic {
  id Int @id @default(autoincrement())
  speciality String
  salary String 
  is_available Boolean @default(true)
  phoneNumber String @map("phone")
  hire_date DateTime @db.Date

  idUser Int @unique
  user User @relation(fields: [idUser], references: [id])

  appointments Appointment[]

  @@map("mechanics")
}

model Receptionist {
  id Int @id @default(autoincrement())
  salary String
  hire_date DateTime @db.Date
  phoneNumber String @map("phone")
  is_active Boolean @default(true)

  idUser Int @unique
  user User @relation(fields: [idUser], references: [id])

  @@map("receptionists")
}


model Appointment {
  id Int @id @default(autoincrement())
  reference String @unique
  type AppointmentType
  date DateTime @db.Date
  time String
  description String?
  status AppointmentStatus @default(PENDING)
  reminderSentAt DateTime? @map("reminder_sent_at")
  idCustomer Int
  customer Customer @relation(fields: [idCustomer], references: [id])
  idVehicle Int
  vehicle Vehicle @relation(fields: [idVehicle], references: [id])
  idMechanic Int?
  mechanic Mechanic? @relation(fields: [idMechanic], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@index([status])
  @@index([idCustomer])
  @@map("appointments")
}

model AppointmentCounter {
  year        Int    @id
  lastNumber  Int    @default(0)

  @@map("appointment_counters")
}


view ReceptionistView {
  receptionist_id Int
  user_id Int
  name String
  first_name String
  email String
  hire_date DateTime
  salary String
  is_active Boolean
  created_at DateTime
  updated_at DateTime


  @@map("receptionist_view")
}

view MechanicView {
  mechanic_id Int
  user_id Int
  name String
  first_name String
  email String
  hire_date DateTime
  salary String
  speciality String
  is_available Boolean
  created_at DateTime
  updated_at DateTime


  @@map("mechanic_view")
}



enum AppointmentType {
  ROUTINE_MAINTENANCE    // ENTRETIEN_COURANT
  PERIODIC_SERVICE       // REVISION_PERIODIQUE
  MECHANICAL_REPAIR      // REPARATION_MECANIQUE
  DIAGNOSTIC             // DIAGNOSTIC
  BODYWORK               // CARROSSERIE
  TECHNICAL_INSPECTION   // CONTROLE_TECHNIQUE
  TIRE_FITTING           // MONTAGE_PNEUS
  OTHER                  // AUTRE
}

enum AppointmentStatus {
  PENDING          // EN_ATTENTE
  CONFIRMED        // CONFIRME
  REMINDER_SENT    // RAPPEL_ENVOYE
  CLIENT_PRESENT   // CLIENT_PRESENT
  OR_CREATED       // OR_CREE
  COMPLETED        // TERMINE
  CANCELLED        // ANNULE
  NO_SHOW          // NO_SHOW
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum Fuel {
  ESSENCE
  DIESEL
}
enum Role {
  MECHANIC
  ADMIN
  RECEPTIONIST
  WORKSHOP_MANAGER
}

